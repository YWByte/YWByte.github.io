---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, postHref } from '../utils';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="归档" nav="archive">
  <main class="main">
    <div class="intro"><h1>归档</h1><p>共 {posts.length} 篇文章。</p></div>
    {years.map((y) => (
      <section>
        <h2 class="year">{y}</h2>
        {posts.filter((p) => p.data.date.getFullYear() === y).map((p) => (
          <a class="row" href={postHref(p)}><time>{formatDate(p.data.date).slice(5)}</time>{p.data.title}</a>
        ))}
      </section>
    ))}
  </main>
</Base>
